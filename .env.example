# =====================================================================
# Database Configuration
# =====================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# DB Target / SOT Agent
DB_NAME=intransit_agent

# DB Source (admin_dashboard3 di server yang sama)
DB_SOURCE_NAME=admin_dashboard3

# =====================================================================
# IIAWeb Configuration
# =====================================================================
IIA_BASE_URL=http://10.254.137.47/IIAWeb
IIA_LOGIN_URL=http://10.254.137.47/IIAWeb/Account/Login
IIA_USERNAME=
IIA_PASSWORD=
IIA_RESP_ID=91
IIA_MENU_ID=14
IIA_FIELD_USER=UserName
IIA_FIELD_PASS=Password

# =====================================================================
# Evolution API (WhatsApp Gateway)
# =====================================================================
EVO_URL=http://localhost:8080
EVO_APIKEY=
EVO_INSTANCE=rekap_intransit

# Nomor WA lu untuk alur approval (Format: 628xxx)
OWNER_WA=

# JID Grup WA Gabungan (pisahkan dengan koma jika lebih dari 1)
# Contoh: 120363404708425192@g.us,628883800266-1502079935@g.us
TARGET_GROUP_JIDS=120363404708425192@g.us,628883800266-1502079935@g.us

# =====================================================================
# LLM Gateway (9router / OpenAI-Compatible)
# =====================================================================
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_MODEL_SMART=gpt-4o
LLM_DAILY_TOKEN_BUDGET=500000

# =====================================================================
# Business Rules / Thresholds
# =====================================================================
# Batas umur intransit (hari) sebelum mulai diangkat jadi kasus yang ditagih
AMBANG_INTRANSIT_HARI=3

# Default PriceList ID untuk master PLU
DEFAULT_PRICELIST_ID=80
